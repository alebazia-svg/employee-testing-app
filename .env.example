DATABASE_URL="postgresql://employee_testing:employee_testing_password@localhost:5432/employee_testing?schema=public"

# Google Sheets integration for admin / attendance.
# Keep real values only in .env, never commit private keys.
GOOGLE_SHEETS_CLIENT_EMAIL=""
GOOGLE_SHEETS_PRIVATE_KEY=""
GOOGLE_SHEETS_SPREADSHEET_ID=""
GOOGLE_SHEETS_SCHEDULE_SPREADSHEET_ID=""

# 1C AIAgentAPI read-only integration.
1C_BASE_URL=""
1C_API_USER=""
1C_API_PASSWORD=""
1C_REQUEST_TIMEOUT_MS="5000"
1C_CACHE_TTL_SECONDS="30"

# Saby OFD read-only probe. Keep real values only in .env/server.env.
SABY_OFD_ENABLED="false"
SABY_OFD_BASE_URL="https://online.sbis.ru"
SABY_OFD_APP_CLIENT_ID=""
SABY_OFD_APP_SECRET=""
SABY_OFD_SECRET_KEY=""
SABY_OFD_REQUEST_TIMEOUT_MS="10000"
SABY_OFD_ORGANIZATION_INN=""

# Internal read-only AUSN OFD export for Codex. Keep the real token in .env/server.env only.
AUSN_OFD_EXPORT_TOKEN=""
