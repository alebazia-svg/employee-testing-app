[Unit]
Description=Retry OFFONIKA cash operations after 1C recovery
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/flock -n -E 0 /run/lock/offonika-cash-operation-retry.lock /usr/bin/docker exec portal-app node --conditions=react-server --import tsx scripts/retry-failed-cash-operations.ts
TimeoutStartSec=5min
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
