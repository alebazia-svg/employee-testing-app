[Unit]
Description=OFFONIKA accountable cash read-only check and portal reminder
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/flock -n -E 0 /run/lock/offonika-procurement-delivery.lock /usr/bin/docker exec portal-app node --conditions=react-server --import tsx scripts/procurement-delivery-sync.ts --confirm-portal-write
TimeoutStartSec=60
NoNewPrivileges=true
PrivateTmp=true
