[Unit]
Description=OFFONIKA expense request read-only sync and ADMIN delivery
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/flock -n -E 0 /run/lock/offonika-expense-request-sync.lock /docker/employee-testing-app/ops/systemd/run-offonika-expense-request-sync.sh
TimeoutStartSec=5min
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
