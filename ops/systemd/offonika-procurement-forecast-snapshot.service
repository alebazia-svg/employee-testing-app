[Unit]
Description=OFFONIKA procurement financial snapshot
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/flock -n -E 0 /run/lock/offonika-procurement-forecast-snapshot.lock /docker/employee-testing-app/ops/systemd/run-offonika-procurement-forecast-snapshot.sh
TimeoutStartSec=3min
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
