PORTAL_DOMAIN=portal.alebazia.xyz

POSTGRES_DB=employee_testing
POSTGRES_USER=employee_testing
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

DATABASE_URL=postgresql://employee_testing:CHANGE_ME_STRONG_PASSWORD@portal-postgres:5432/employee_testing?schema=public

GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
