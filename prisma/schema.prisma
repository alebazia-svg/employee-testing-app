generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        Int                        @id @default(autoincrement())
  name                      String
  login                     String                     @unique
  passwordHash              String
  role                      String
  department                String                     @default("retail")
  isActive                  Boolean                    @default(true)
  payrollName               String?
  results                   Result[]
  progresses                AttemptProgress[]
  resetTargets              AttemptReset[]             @relation("ResetTarget")
  resetByActions            AttemptReset[]             @relation("ResetBy")
  payrollRuns               PayrollRun[]               @relation("PayrollRunCreatedBy")
  payrollAdjustments        PayrollAdjustment[]        @relation("PayrollAdjustmentCreatedBy")
  workSchedules             WorkScheduleEntry[]
  workDays                  WorkDayEntry[]
  shiftControlRuns          ShiftControlRun[]
  shiftControlManualReviews ShiftControlManualReview[] @relation("ShiftControlManualReviewReviewedBy")
  cashOperations            CashOperation[]
  oneCCashboxMapping        UserOneCCashboxMapping?
  pushSubscriptions         WorkdayPushSubscription[]
  workdayNotifications      WorkdayNotification[]
  workdayControlIssues      WorkdayControlIssue[]
  kkmAssignments            WorkdayKkmAssignment[]     @relation("WorkdayKkmAssignmentEmployee")
  assignedKkmAssignments    WorkdayKkmAssignment[]     @relation("WorkdayKkmAssignmentAssignedBy")
}

model UserOneCCashboxMapping {
  id                        Int      @id @default(autoincrement())
  userId                    Int      @unique
  oneCCashboxRef            String
  oneCCashboxName           String
  oneCCashRegisterRef       String?
  oneCCashRegisterName      String?
  oneCAcquiringTerminalRef  String?
  oneCAcquiringTerminalName String?
  tbankTerminalId           String?
  kkmMode                   String   @default("personal")
  isActive                  Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([oneCCashboxRef])
  @@index([oneCCashRegisterRef])
  @@index([tbankTerminalId])
  @@index([isActive])
}

model WorkdayKkmAssignment {
  id                   Int           @id @default(autoincrement())
  userId               Int
  date                 String
  plannedShiftCode     String?
  oneCCashRegisterRef  String
  oneCCashRegisterName String
  kkmMode              String        @default("personal")
  source               String        @default("manual")
  note                 String        @default("")
  effectiveFrom        DateTime
  effectiveTo          DateTime?
  changeReason         String        @default("")
  assignedById         Int
  assignedAt           DateTime      @default(now())
  workDayEntryId       Int?
  updatedAt            DateTime      @updatedAt
  user                 User          @relation("WorkdayKkmAssignmentEmployee", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy           User          @relation("WorkdayKkmAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  workDayEntry         WorkDayEntry? @relation(fields: [workDayEntryId], references: [id], onDelete: SetNull)

  @@index([userId, date, effectiveFrom])
  @@index([date, effectiveFrom, effectiveTo])
  @@index([oneCCashRegisterRef, date])
  @@index([assignedById, assignedAt])
}

model WorkScheduleEntry {
  id         Int      @id @default(autoincrement())
  userId     Int
  date       String
  department String
  status     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
  @@index([department, date])
  @@index([status])
}

model WorkDayEntry {
  id                Int                    @id @default(autoincrement())
  userId            Int
  date              String
  department        String
  shiftCode         String
  shiftLabel        String
  shiftStartMinutes Int?
  shiftEndMinutes   Int?
  startedAt         DateTime               @default(now())
  endedAt           DateTime?
  lateMinutes       Int                    @default(0)
  comment           String                 @default("")
  status            String                 @default("active")
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiftControlRun   ShiftControlRun?
  cashOperations    CashOperation[]
  kkmAssignments    WorkdayKkmAssignment[]

  @@unique([userId, date])
  @@index([date])
  @@index([department, date])
  @@index([status])
}

model CashOperation {
  id                 Int          @id @default(autoincrement())
  userId             Int
  workDayEntryId     Int
  date               String
  department         String
  direction          String
  amount             Float
  photoPath          String
  comment            String       @default("")
  status             String       @default("pending_1c")
  idempotencyKey     String       @unique
  oneCDocumentRef    String?
  oneCDocumentNumber String?
  oneCError          String       @default("")
  oneCCreatedAt      DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workDayEntry       WorkDayEntry @relation(fields: [workDayEntryId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([workDayEntryId])
  @@index([direction])
  @@index([status])
  @@index([oneCDocumentRef])
}

model ShiftControlTemplate {
  id         Int                        @id @default(autoincrement())
  name       String
  department String
  shiftCode  String                     @default("default")
  isActive   Boolean                    @default(true)
  version    Int                        @default(1)
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt
  tasks      ShiftControlTemplateTask[]
  runs       ShiftControlRun[]

  @@unique([department, shiftCode, version])
  @@index([department, shiftCode, isActive])
}

model ShiftControlTemplateTask {
  id                 Int                  @id @default(autoincrement())
  templateId         Int
  title              String
  category           String
  sortOrder          Int
  required           Boolean              @default(true)
  plannedTimeMinutes Int?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  template           ShiftControlTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tasks              ShiftControlTask[]

  @@index([templateId, sortOrder])
  @@index([category])
}

model ShiftControlRun {
  id             Int                   @id @default(autoincrement())
  workDayEntryId Int                   @unique
  userId         Int
  department     String
  date           String
  templateId     Int?
  status         String                @default("active")
  startedAt      DateTime              @default(now())
  submittedAt    DateTime?
  completedAt    DateTime?
  closingComment String                @default("")
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  workDayEntry   WorkDayEntry          @relation(fields: [workDayEntryId], references: [id], onDelete: Cascade)
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  template       ShiftControlTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  tasks          ShiftControlTask[]

  @@index([userId, date])
  @@index([department, date])
  @@index([status])
}

model ShiftControlTask {
  id                 Int                        @id @default(autoincrement())
  runId              Int
  templateTaskId     Int?
  title              String
  category           String
  sortOrder          Int
  required           Boolean                    @default(true)
  plannedTimeMinutes Int?
  status             String                     @default("pending")
  completedAt        DateTime?
  numericValue       Float?
  integerValue       Int?
  booleanValue       Boolean?
  textValue          String?
  handoverData       Json?
  comment            String                     @default("")
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  run                ShiftControlRun            @relation(fields: [runId], references: [id], onDelete: Cascade)
  templateTask       ShiftControlTemplateTask?  @relation(fields: [templateTaskId], references: [id], onDelete: SetNull)
  manualReviews      ShiftControlManualReview[]
  notifications      WorkdayNotification[]
  controlIssues      WorkdayControlIssue[]

  @@index([runId, sortOrder])
  @@index([status])
  @@index([category])
}

model WorkdayPushSubscription {
  id         Int       @id @default(autoincrement())
  userId     Int
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String    @default("")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  disabledAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, disabledAt])
}

model WorkdayControlIssue {
  id             Int                   @id @default(autoincrement())
  userId         Int
  taskId         Int?
  fingerprint    String                @unique
  ruleKey        String
  severity       String
  status         String                @default("open")
  title          String
  detail         String
  sourceData     Json?
  detectedAt     DateTime              @default(now())
  lastDetectedAt DateTime              @default(now())
  nextReminderAt DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task           ShiftControlTask?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  notifications  WorkdayNotification[]

  @@index([userId, status])
  @@index([taskId, status])
  @@index([status, nextReminderAt])
}

model WorkdayNotification {
  id           Int                  @id @default(autoincrement())
  userId       Int
  taskId       Int?
  issueId      Int?
  fingerprint  String               @unique
  kind         String
  title        String
  body         String
  status       String               @default("pending")
  scheduledAt  DateTime
  sentAt       DateTime?
  readAt       DateTime?
  attemptCount Int                  @default(0)
  lastError    String               @default("")
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  task         ShiftControlTask?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  issue        WorkdayControlIssue? @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([userId, status, scheduledAt])
  @@index([taskId, kind])
  @@index([issueId, kind])
}

model ShiftControlManualReview {
  id           Int              @id @default(autoincrement())
  taskId       Int
  checkId      String
  checkLabel   String
  decision     String
  comment      String
  reviewedById Int
  reviewedAt   DateTime         @default(now())
  createdAt    DateTime         @default(now())
  task         ShiftControlTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reviewedBy   User             @relation("ShiftControlManualReviewReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([taskId, checkId, reviewedAt])
  @@index([reviewedById, reviewedAt])
}

model Attestation {
  id           Int               @id @default(autoincrement())
  title        String
  passingScore Int
  status       String            @default("DRAFT")
  type         String            @default("PRACTICE")
  sections     Section[]
  results      Result[]
  progresses   AttemptProgress[]
  resets       AttemptReset[]
}

model Section {
  id            Int         @id @default(autoincrement())
  title         String
  order         Int         @default(0)
  attestationId Int
  attestation   Attestation @relation(fields: [attestationId], references: [id], onDelete: Cascade)
  questions     Question[]
}

model Question {
  id           Int     @id @default(autoincrement())
  text         String
  options      String
  correctIndex Int
  order        Int     @default(0)
  sectionId    Int
  section      Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

model AttemptProgress {
  id            Int         @id @default(autoincrement())
  userId        Int
  attestationId Int
  answers       String      @default("{}")
  questionOrder String
  currentIndex  Int         @default(0)
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  attestation   Attestation @relation(fields: [attestationId], references: [id], onDelete: Cascade)

  @@unique([userId, attestationId])
}

model Result {
  id             Int         @id @default(autoincrement())
  userId         Int
  attestationId  Int
  date           DateTime    @default(now())
  percent        Int
  status         String
  correctCount   Int
  totalQuestions Int
  mistakes       Int
  details        String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  attestation    Attestation @relation(fields: [attestationId], references: [id], onDelete: Cascade)
}

model AttemptReset {
  id            Int         @id @default(autoincrement())
  userId        Int
  attestationId Int
  resetById     Int
  date          DateTime    @default(now())
  user          User        @relation("ResetTarget", fields: [userId], references: [id], onDelete: Cascade)
  resetBy       User        @relation("ResetBy", fields: [resetById], references: [id], onDelete: Cascade)
  attestation   Attestation @relation(fields: [attestationId], references: [id], onDelete: Cascade)
}

model PayrollPeriod {
  id        Int          @id @default(autoincrement())
  year      Int
  month     Int
  periodKey String       @unique
  status    String       @default("OPEN")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  closedAt  DateTime?
  runs      PayrollRun[]

  @@unique([year, month])
}

model PayrollRun {
  id              Int                     @id @default(autoincrement())
  periodId        Int
  runNumber       Int
  status          String                  @default("DRAFT")
  rulesVersion    String                  @default("client-snapshot-v1")
  employeeCount   Int                     @default(0)
  reviewCount     Int                     @default(0)
  grossPay        Float                   @default(0)
  netPay          Float                   @default(0)
  advance         Float                   @default(0)
  deductions      Float                   @default(0)
  dayPay          Float                   @default(0)
  salesBonus      Float                   @default(0)
  disciplineBonus Float                   @default(0)
  sourceSummary   Json?
  createdByUserId Int?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  checkedAt       DateTime?
  closedAt        DateTime?
  period          PayrollPeriod           @relation(fields: [periodId], references: [id], onDelete: Cascade)
  createdBy       User?                   @relation("PayrollRunCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  employeeResults PayrollEmployeeResult[]
  sourceFiles     PayrollSourceFile[]
  manualInputs    PayrollManualInput[]
  adjustments     PayrollAdjustment[]
  analyticsRows   PayrollAnalyticsRow[]

  @@unique([periodId, runNumber])
}

model PayrollEmployeeResult {
  id                       Int                        @id @default(autoincrement())
  runId                    Int
  employeeName             String
  userId                   Int?
  department               String
  payrollDepartment        String
  position                 String
  salaryType               String
  salaryRule               String
  workedDays               Float?
  lateCount                Float?
  daysSource               String
  dayRate                  Float                      @default(0)
  dayPay                   Float                      @default(0)
  revenue                  Float                      @default(0)
  grossProfit              Float                      @default(0)
  creditBonus              Float                      @default(0)
  filmBonus                Float                      @default(0)
  plotterBonus             Float                      @default(0)
  techBonus                Float                      @default(0)
  accessoryBonus           Float                      @default(0)
  wholesaleBonus           Float                      @default(0)
  salesBonus               Float                      @default(0)
  totalBonus               Float                      @default(0)
  disciplineBonus          Float                      @default(0)
  fixedSalary              Float                      @default(0)
  fixedBonus               Float                      @default(0)
  fixedDeduction           Float                      @default(0)
  purchaseBase             Float?
  purchasePercent          Float                      @default(0)
  purchasePercentAmount    Float                      @default(0)
  purchaseTargetAdjustment Float                      @default(0)
  purchaseTargetSalary     Float                      @default(0)
  agentCreditCommission    Float                      @default(0)
  advance                  Float                      @default(0)
  grossPay                 Float                      @default(0)
  netPay                   Float                      @default(0)
  status                   String
  reasons                  Json?
  comment                  String                     @default("")
  order                    Int                        @default(0)
  run                      PayrollRun                 @relation(fields: [runId], references: [id], onDelete: Cascade)
  calculationDetails       PayrollCalculationDetail[]
  adjustments              PayrollAdjustment[]

  @@index([runId])
  @@index([employeeName])
}

model PayrollSourceFile {
  id             Int                   @id @default(autoincrement())
  runId          Int
  type           String
  originalName   String
  extension      String
  mimeType       String?
  sizeBytes      Int?
  sha256         String?
  uploadedAt     DateTime              @default(now())
  selectedSheet  String?
  rowCount       Int?
  parsedRowCount Int?
  status         String                @default("UPLOADED")
  warnings       Json?
  metadata       Json?
  run            PayrollRun            @relation(fields: [runId], references: [id], onDelete: Cascade)
  analyticsRows  PayrollAnalyticsRow[]

  @@index([runId])
  @@index([sha256])
}

model PayrollAnalyticsRow {
  id                  Int                @id @default(autoincrement())
  payrollRunId        Int
  sourceFileId        Int?
  periodKey           String
  year                Int
  month               Int
  employeeName        String
  employeeId          Int?
  department          String?
  location            String?
  client              String?
  category            String?
  nomenclatureType    String?
  itemName            String
  article             String?
  quantity            Float?
  revenue             Float              @default(0)
  cost                Float              @default(0)
  grossProfit         Float              @default(0)
  marginPercent       Float?
  markupPercent       Float?
  calculationType     String
  componentType       String?
  commissionAmount    Float              @default(0)
  isCredit            Boolean            @default(false)
  isReturn            Boolean            @default(false)
  isNegative          Boolean            @default(false)
  isManualRuleApplied Boolean            @default(false)
  manualRuleLabel     String?
  problemFlags        Json?
  checkReason         String?
  createdAt           DateTime           @default(now())
  payrollRun          PayrollRun         @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  sourceFile          PayrollSourceFile? @relation(fields: [sourceFileId], references: [id], onDelete: SetNull)

  @@index([payrollRunId])
  @@index([periodKey])
  @@index([employeeName])
  @@index([calculationType])
  @@index([isCredit])
  @@index([isNegative])
}

model SalesAnalyticsReport {
  id               Int                 @id @default(autoincrement())
  period           String
  sourceReportType String              @default("extended_vgp")
  fileName         String
  uploadedAt       DateTime            @default(now())
  rowsCount        Int                 @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  rows             SalesAnalyticsRow[]

  @@index([period])
  @@index([sourceReportType])
  @@index([uploadedAt])
}

model SalesAnalyticsRow {
  id               Int                  @id @default(autoincrement())
  reportId         Int
  sourceReportType String               @default("extended_vgp")
  employeeName     String
  department       String?
  location         String?
  client           String?
  category         String?
  nomenclatureType String?
  itemName         String
  article          String?
  quantity         Float?
  revenue          Float                @default(0)
  cost             Float                @default(0)
  grossProfit      Float                @default(0)
  marginPercent    Float?
  markupPercent    Float?
  documentName     String?
  documentType     String               @default("UNKNOWN")
  documentDate     DateTime?
  unitRevenue      Float?
  unitCost         Float?
  unitGrossProfit  Float?
  isCredit         Boolean              @default(false)
  isReturn         Boolean              @default(false)
  isRealReturn     Boolean              @default(false)
  isNegative       Boolean              @default(false)
  problemFlags     Json?
  checkReason      String?
  createdAt        DateTime             @default(now())
  report           SalesAnalyticsReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([sourceReportType])
  @@index([employeeName])
  @@index([documentType])
  @@index([isCredit])
  @@index([isRealReturn])
  @@index([isNegative])
}

model PayrollManualInput {
  id                    Int        @id @default(autoincrement())
  runId                 Int
  employeeName          String
  inputType             String
  workedDays            String?
  lateCount             String?
  advance               String?
  agentCreditCommission String?
  fixedBonus            String?
  fixedDeduction        String?
  purchaseAdvance       String?
  purchaseDeduction     String?
  comment               String     @default("")
  source                String?
  updatedAt             DateTime   @default(now())
  run                   PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([employeeName])
}

model PayrollCalculationDetail {
  id               Int                   @id @default(autoincrement())
  employeeResultId Int
  component        String
  base             Float?
  formula          String
  amount           Float                 @default(0)
  comment          String                @default("")
  order            Int                   @default(0)
  employeeResult   PayrollEmployeeResult @relation(fields: [employeeResultId], references: [id], onDelete: Cascade)

  @@index([employeeResultId])
}

model PayrollAdjustment {
  id               Int                    @id @default(autoincrement())
  runId            Int
  employeeResultId Int?
  type             String
  amount           Float                  @default(0)
  reason           String
  comment          String                 @default("")
  createdByUserId  Int?
  createdAt        DateTime               @default(now())
  run              PayrollRun             @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeResult   PayrollEmployeeResult? @relation(fields: [employeeResultId], references: [id], onDelete: Cascade)
  createdBy        User?                  @relation("PayrollAdjustmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([employeeResultId])
}

model PayrollClassificationRule {
  id                    Int      @id @default(autoincrement())
  title                 String?
  isActive              Boolean  @default(true)
  priority              Int      @default(100)
  matchType             String
  itemText              String?
  categoryText          String?
  article               String?
  department            String?  @default("all")
  saleContext           String?  @default("all")
  targetCalculationType String
  reason                String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([isActive, priority])
  @@index([matchType])
  @@index([targetCalculationType])
}
