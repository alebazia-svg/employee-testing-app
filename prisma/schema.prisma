generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                           Int                            @id @default(autoincrement())
  name                         String
  login                        String                         @unique
  passwordHash                 String
  role                         String
  department                   String                         @default("retail")
  isActive                     Boolean                        @default(true)
  payrollName                  String?
  results                      Result[]
  progresses                   AttemptProgress[]
  resetTargets                 AttemptReset[]                 @relation("ResetTarget")
  resetByActions               AttemptReset[]                 @relation("ResetBy")
  payrollRuns                  PayrollRun[]                   @relation("PayrollRunCreatedBy")
  payrollAdjustments           PayrollAdjustment[]            @relation("PayrollAdjustmentCreatedBy")
  workSchedules                WorkScheduleEntry[]
  workDays                     WorkDayEntry[]
  shiftControlRuns             ShiftControlRun[]
  shiftControlManualReviews    ShiftControlManualReview[]     @relation("ShiftControlManualReviewReviewedBy")
  cashOperations               CashOperation[]
  oneCCashboxMapping           UserOneCCashboxMapping?
  pushSubscriptions            WorkdayPushSubscription[]
  workdayNotifications         WorkdayNotification[]
  workdayControlIssues         WorkdayControlIssue[]
  kkmAssignments               WorkdayKkmAssignment[]         @relation("WorkdayKkmAssignmentEmployee")
  assignedKkmAssignments       WorkdayKkmAssignment[]         @relation("WorkdayKkmAssignmentAssignedBy")
  expenseRequestCasesSeen      ExpenseRequestAdminCase[]      @relation("ExpenseRequestCaseSeenBy")
  expenseRequestCasesReviewed  ExpenseRequestAdminCase[]      @relation("ExpenseRequestCaseReviewedBy")
  expenseRequestFeedback       ExpenseRequestAdminFeedback[]
  adminInboxReceipts           AdminInboxReceipt[]
  terminalFiscalReviews        TerminalFiscalEmployeeReview[] @relation("TerminalFiscalReviewEmployee")
  terminalFiscalReviewMessages TerminalFiscalReviewMessage[]  @relation("TerminalFiscalReviewMessageAuthor")
  workdayIssueMessages         WorkdayControlIssueMessage[]   @relation("WorkdayControlIssueMessageAuthor")
  workdayCloseRequests         WorkdayCloseExceptionRequest[] @relation("WorkdayCloseExceptionEmployee")
  decidedWorkdayCloseRequests  WorkdayCloseExceptionRequest[] @relation("WorkdayCloseExceptionDecidedBy")
}

model ExpenseRequestSyncRun {
  id                  String                          @id @default(cuid())
  runKey              String                          @unique
  periodFrom          DateTime
  periodTo            DateTime
  status              String
  sourceComplete      Boolean                         @default(false)
  sourceRowCount      Int                             @default(0)
  createdCaseCount    Int                             @default(0)
  updatedCaseCount    Int                             @default(0)
  evaluationCount     Int                             @default(0)
  newNotApprovedCount Int                             @default(0)
  errorCode           String?
  startedAt           DateTime                        @default(now())
  completedAt         DateTime?
  createdAt           DateTime                        @default(now())
  evaluations         ExpenseRequestAdminEvaluation[]

  @@index([periodFrom, periodTo])
  @@index([status, startedAt])
}

model ExpenseRequestAdminCase {
  id                      String                          @id @default(cuid())
  oneCRequestRef          String                          @unique
  oneCNumber              String                          @default("")
  oneCDate                DateTime?
  posted                  Boolean?
  deletionMark            Boolean?
  currentStatusKey        String                          @default("")
  currentStatusName       String                          @default("")
  isNotApproved           Boolean                         @default(false)
  notApprovedCycle        Int                             @default(0)
  currentCycleOrigin      String                          @default("")
  enteredNotApprovedAt    DateTime?
  firstSeenAt             DateTime                        @default(now())
  lastSeenAt              DateTime                        @default(now())
  seenAt                  DateTime?
  seenById                Int?
  reviewedAt              DateTime?
  reviewedById            Int?
  latestSourceHash        String                          @default("")
  latestRuleVersion       String                          @default("")
  latestCategory          String                          @default("")
  latestCompletenessState String                          @default("")
  requestedByRef          String                          @default("")
  requestedByName         String                          @default("")
  amount                  Decimal?                        @db.Decimal(18, 2)
  businessOperationName   String                          @default("")
  counterpartyName        String                          @default("")
  createdAt               DateTime                        @default(now())
  updatedAt               DateTime                        @updatedAt
  seenBy                  User?                           @relation("ExpenseRequestCaseSeenBy", fields: [seenById], references: [id], onDelete: SetNull)
  reviewedBy              User?                           @relation("ExpenseRequestCaseReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  evaluations             ExpenseRequestAdminEvaluation[]
  feedback                ExpenseRequestAdminFeedback[]

  @@index([isNotApproved, seenAt, oneCDate])
  @@index([isNotApproved, currentCycleOrigin, deletionMark, oneCDate])
  @@index([currentStatusKey, oneCDate])
  @@index([requestedByRef, oneCDate])
  @@index([latestCompletenessState, oneCDate])
}

model ExpenseRequestAdminEvaluation {
  id                 String                        @id @default(cuid())
  caseId             String
  syncRunId          String
  notApprovedCycle   Int
  sourceHash         String
  ruleVersion        String
  category           String
  categoryCandidates Json
  completenessState  String
  evidenceState      String
  reasonCodes        Json
  missingInformation Json
  suggestedQuestion  String?
  decisionSources    Json
  confidence         String
  ambiguous          Boolean
  sourceComplete     Boolean
  normalizedSource   Json
  evaluatedAt        DateTime                      @default(now())
  createdAt          DateTime                      @default(now())
  case               ExpenseRequestAdminCase       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  syncRun            ExpenseRequestSyncRun         @relation(fields: [syncRunId], references: [id], onDelete: Restrict)
  feedback           ExpenseRequestAdminFeedback[]

  @@unique([caseId, notApprovedCycle, sourceHash, ruleVersion])
  @@index([caseId, evaluatedAt])
  @@index([completenessState, evaluatedAt])
  @@index([syncRunId])
}

model ExpenseRequestAdminFeedback {
  id           String                         @id @default(cuid())
  caseId       String
  evaluationId String?
  scope        String                         @default("overall")
  reasonCode   String?
  decision     String
  comment      String                         @default("")
  reviewedById Int
  createdAt    DateTime                       @default(now())
  case         ExpenseRequestAdminCase        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  evaluation   ExpenseRequestAdminEvaluation? @relation(fields: [evaluationId], references: [id], onDelete: SetNull)
  reviewedBy   User                           @relation(fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([caseId, createdAt])
  @@index([evaluationId, reasonCode, createdAt])
  @@index([decision, createdAt])
  @@index([reviewedById, createdAt])
}

model AdminInboxEvent {
  id         String               @id @default(cuid())
  eventKey   String               @unique
  type       String
  title      String
  body       String
  href       String
  sourceType String
  sourceId   String
  occurredAt DateTime
  createdAt  DateTime             @default(now())
  receipts   AdminInboxReceipt[]
  deliveries AdminInboxDelivery[]

  @@index([type, occurredAt])
  @@index([sourceType, sourceId, occurredAt])
}

model AdminInboxDelivery {
  id                String          @id @default(cuid())
  eventId           String
  channel           String
  recipientKey      String
  status            String          @default("pending")
  attemptCount      Int             @default(0)
  leaseToken        String?
  leaseUntil        DateTime?
  sentAt            DateTime?
  externalMessageId String?
  lastErrorCode     String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  event             AdminInboxEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, channel, recipientKey])
  @@index([channel, status, createdAt])
}

model AdminInboxReceipt {
  id        String          @id @default(cuid())
  eventId   String
  userId    Int
  readAt    DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  event     AdminInboxEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId, readAt, createdAt])
}

model TerminalFiscalMapping {
  id                       String                         @id @default(cuid())
  label                    String                         @default("")
  terminalKey              String
  tbankTerminalId          String?
  oneCAcquiringTerminalRef String
  oneCCashRegisterRef      String
  kktRegistrationNumber    String
  effectiveFrom            DateTime
  effectiveTo              DateTime?
  source                   String                         @default("manual")
  isActive                 Boolean                        @default(true)
  createdAt                DateTime                       @default(now())
  updatedAt                DateTime                       @updatedAt
  workstationId            String?
  workstation              RetailWorkstation?             @relation(fields: [workstationId], references: [id], onDelete: SetNull)
  runs                     TerminalFiscalMatchRun[]
  matches                  TerminalFiscalMatch[]
  employeeReviews          TerminalFiscalEmployeeReview[]

  @@index([terminalKey, effectiveFrom, effectiveTo])
  @@index([oneCAcquiringTerminalRef, effectiveFrom, effectiveTo])
  @@index([oneCCashRegisterRef, effectiveFrom, effectiveTo])
  @@index([kktRegistrationNumber, effectiveFrom, effectiveTo])
  @@index([isActive, effectiveFrom, effectiveTo])
  @@index([workstationId, effectiveFrom, effectiveTo])
}

model RetailWorkstation {
  id                     String                  @id @default(cuid())
  code                   String                  @unique
  label                  String
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  terminalFiscalMappings TerminalFiscalMapping[]

  @@index([isActive, code])
}

model TerminalFiscalMatchRun {
  id               String                          @id @default(cuid())
  runKey           String                          @unique
  algorithmVersion String
  mappingId        String
  periodFrom       DateTime
  periodTo         DateTime
  status           String                          @default("pending")
  cycleKey         String?
  leaseToken       String?
  leaseUntil       DateTime?
  attemptCount     Int                             @default(0)
  tbankComplete    Boolean                         @default(false)
  oneCComplete     Boolean                         @default(false)
  ofdComplete      Boolean                         @default(false)
  tbankCheckedAt   DateTime?
  oneCCheckedAt    DateTime?
  ofdCheckedAt     DateTime?
  lastErrorCode    String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt
  mapping          TerminalFiscalMapping           @relation(fields: [mappingId], references: [id], onDelete: Restrict)
  matches          TerminalFiscalMatch[]
  evaluations      TerminalFiscalMatchEvaluation[]

  @@index([mappingId, periodFrom, periodTo])
  @@index([status, leaseUntil])
  @@index([cycleKey])
}

model TerminalFiscalMatch {
  id                    String                          @id @default(cuid())
  matchingId            String                          @unique
  runId                 String
  mappingId             String?
  algorithmVersion      String
  status                String
  reasonCode            String
  operationType         String?
  bankOperationAt       DateTime?
  bankOperationHash     String
  oneCSourceRef         String?
  oneCSourceHash        String?
  oneCCashierRef        String?
  ofdFiscalKeyHash      String?
  candidateCount        Int                             @default(0)
  timeDifferenceSeconds Int?
  graceUntil            DateTime
  tbankComplete         Boolean
  oneCComplete          Boolean
  ofdComplete           Boolean
  checkedAt             DateTime
  createdAt             DateTime                        @default(now())
  updatedAt             DateTime                        @updatedAt
  run                   TerminalFiscalMatchRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  mapping               TerminalFiscalMapping?          @relation(fields: [mappingId], references: [id], onDelete: Restrict)
  evaluations           TerminalFiscalMatchEvaluation[]

  @@index([runId, status])
  @@index([mappingId, checkedAt])
  @@index([mappingId, bankOperationAt])
  @@index([reasonCode, checkedAt])
  @@index([bankOperationHash])
  @@index([oneCSourceRef])
  @@index([oneCCashierRef])
  @@index([ofdFiscalKeyHash])
}

model TerminalFiscalMatchEvaluation {
  id                    String                 @id @default(cuid())
  matchId               String
  runId                 String
  cycleKey              String
  algorithmVersion      String
  status                String
  reasonCode            String
  mappingId             String?
  bankOperationAt       DateTime?
  bankOperationHash     String
  oneCSourceRef         String?
  oneCSourceHash        String?
  oneCCashierRef        String?
  ofdFiscalKeyHash      String?
  candidateCount        Int                    @default(0)
  timeDifferenceSeconds Int?
  graceUntil            DateTime
  tbankComplete         Boolean
  oneCComplete          Boolean
  ofdComplete           Boolean
  evaluatedAt           DateTime
  createdAt             DateTime               @default(now())
  match                 TerminalFiscalMatch    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  run                   TerminalFiscalMatchRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([matchId, cycleKey])
  @@index([runId, evaluatedAt])
  @@index([status, reasonCode, evaluatedAt])
}

model TerminalFiscalEmployeeReview {
  id                       String                        @id @default(cuid())
  reviewKey                String                        @unique
  matchingHash             String                        @unique
  mappingId                String?
  employeeId               Int
  status                   String                        @default("open")
  reasonCode               String
  bankOperationAt          DateTime
  amountKopecks            Int
  cashierRefHash           String
  attributionWindowMinutes Int                           @default(15)
  detectedAt               DateTime                      @default(now())
  lastCheckedAt            DateTime                      @default(now())
  resolvedAt               DateTime?
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt
  mapping                  TerminalFiscalMapping?        @relation(fields: [mappingId], references: [id], onDelete: Restrict)
  employee                 User                          @relation("TerminalFiscalReviewEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  messages                 TerminalFiscalReviewMessage[]
  notifications            WorkdayNotification[]

  @@index([employeeId, status, bankOperationAt])
  @@index([status, lastCheckedAt])
  @@index([mappingId, bankOperationAt])
}

model TerminalFiscalReviewMessage {
  id        String                       @id @default(cuid())
  reviewId  String
  authorId  Int
  body      String
  createdAt DateTime                     @default(now())
  review    TerminalFiscalEmployeeReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  author    User                         @relation("TerminalFiscalReviewMessageAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([reviewId, createdAt])
  @@index([authorId, createdAt])
}

model CreditRealizationControlRun {
  id               String                               @id @default(cuid())
  runKey           String                               @unique
  mode             String                               @default("shadow")
  algorithmVersion String
  periodFrom       DateTime
  periodTo         DateTime
  status           String                               @default("running")
  oneCComplete     Boolean                              @default(false)
  ofdComplete      Boolean                              @default(false)
  sourceDocuments  Int                                  @default(0)
  confirmedCount   Int                                  @default(0)
  mismatchCount    Int                                  @default(0)
  needsReviewCount Int                                  @default(0)
  pendingCount     Int                                  @default(0)
  unavailableCount Int                                  @default(0)
  lastErrorCode    String?
  startedAt        DateTime                             @default(now())
  completedAt      DateTime?
  createdAt        DateTime                             @default(now())
  updatedAt        DateTime                             @updatedAt
  evaluations      CreditRealizationControlEvaluation[]

  @@index([status, startedAt])
  @@index([periodFrom, periodTo])
}

model CreditRealizationControlCase {
  id                      String                               @id @default(cuid())
  realizationRef          String                               @unique
  documentNumber          String
  realizationAt           DateTime
  amountKopecks           Int
  managerRef              String?
  status                  String
  reasonCode              String
  employeeActionCandidate Boolean                              @default(false)
  mismatchFirstDetectedAt DateTime?
  completeMismatchReads   Int                                  @default(0)
  receiptDelayMinutes     Int?
  receiptCashierRef       String?
  receiptCashierName      String?
  firstDetectedAt         DateTime                             @default(now())
  lastCheckedAt           DateTime                             @default(now())
  resolvedAt              DateTime?
  createdAt               DateTime                             @default(now())
  updatedAt               DateTime                             @updatedAt
  evaluations             CreditRealizationControlEvaluation[]

  @@index([status, lastCheckedAt])
  @@index([managerRef, status, realizationAt])
  @@index([employeeActionCandidate, status, realizationAt])
}

model CreditRealizationControlEvaluation {
  id                      String                       @id @default(cuid())
  caseId                  String
  runId                   String
  evidenceHash            String
  algorithmVersion        String
  status                  String
  reasonCode              String
  employeeActionCandidate Boolean                      @default(false)
  receiptDelayMinutes     Int?
  receiptCashierRef       String?
  receiptCashierName      String?
  oneCComplete            Boolean
  ofdComplete             Boolean
  evaluatedAt             DateTime
  createdAt               DateTime                     @default(now())
  case                    CreditRealizationControlCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  run                     CreditRealizationControlRun  @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([caseId, evidenceHash])
  @@index([runId, evaluatedAt])
  @@index([status, reasonCode, evaluatedAt])
}

model UserOneCCashboxMapping {
  id                        Int      @id @default(autoincrement())
  userId                    Int      @unique
  oneCCashboxRef            String
  oneCCashboxName           String
  oneCCashRegisterRef       String?
  oneCCashRegisterName      String?
  oneCAcquiringTerminalRef  String?
  oneCAcquiringTerminalName String?
  oneCCashierRef            String?  @unique
  oneCCashierName           String?
  tbankTerminalId           String?
  kkmMode                   String   @default("personal")
  isActive                  Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([oneCCashboxRef])
  @@index([oneCCashRegisterRef])
  @@index([tbankTerminalId])
  @@index([isActive])
}

model WorkdayKkmAssignment {
  id                   Int           @id @default(autoincrement())
  userId               Int
  date                 String
  plannedShiftCode     String?
  oneCCashRegisterRef  String?
  oneCCashRegisterName String?
  kkmMode              String        @default("personal")
  source               String        @default("manual")
  note                 String        @default("")
  effectiveFrom        DateTime
  effectiveTo          DateTime?
  changeReason         String        @default("")
  assignedById         Int?
  assignedAt           DateTime      @default(now())
  workDayEntryId       Int?
  updatedAt            DateTime      @updatedAt
  user                 User          @relation("WorkdayKkmAssignmentEmployee", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy           User?         @relation("WorkdayKkmAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  workDayEntry         WorkDayEntry? @relation(fields: [workDayEntryId], references: [id], onDelete: SetNull)

  @@index([userId, date, effectiveFrom])
  @@index([date, effectiveFrom, effectiveTo])
  @@index([oneCCashRegisterRef, date])
  @@index([assignedById, assignedAt])
}

model WorkScheduleEntry {
  id         Int      @id @default(autoincrement())
  userId     Int
  date       String
  department String
  status     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
  @@index([department, date])
  @@index([status])
}

model WorkDayEntry {
  id                     Int                            @id @default(autoincrement())
  userId                 Int
  date                   String
  department             String
  shiftCode              String
  shiftLabel             String
  shiftStartMinutes      Int?
  shiftEndMinutes        Int?
  startedAt              DateTime                       @default(now())
  endedAt                DateTime?
  lateMinutes            Int                            @default(0)
  comment                String                         @default("")
  status                 String                         @default("active")
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
  user                   User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiftControlRun        ShiftControlRun?
  cashOperations         CashOperation[]
  kkmAssignments         WorkdayKkmAssignment[]
  closeExceptionRequests WorkdayCloseExceptionRequest[]

  @@unique([userId, date])
  @@index([date])
  @@index([department, date])
  @@index([status])
}

model CashOperation {
  id                        Int          @id @default(autoincrement())
  userId                    Int
  workDayEntryId            Int
  date                      String
  department                String
  direction                 String
  amount                    Float
  photoPath                 String
  comment                   String       @default("")
  status                    String       @default("pending_1c")
  idempotencyKey            String       @unique
  oneCDocumentRef           String?
  oneCDocumentNumber        String?
  oneCReceiptDocumentRef    String?
  oneCReceiptDocumentNumber String?
  oneCError                 String       @default("")
  oneCCreatedAt             DateTime?
  oneCPostedAt              DateTime?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt
  user                      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workDayEntry              WorkDayEntry @relation(fields: [workDayEntryId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([workDayEntryId])
  @@index([direction])
  @@index([status])
  @@index([oneCDocumentRef])
  @@index([oneCReceiptDocumentRef])
}

model ShiftControlTemplate {
  id         Int                        @id @default(autoincrement())
  name       String
  department String
  shiftCode  String                     @default("default")
  isActive   Boolean                    @default(true)
  version    Int                        @default(1)
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt
  tasks      ShiftControlTemplateTask[]
  runs       ShiftControlRun[]

  @@unique([department, shiftCode, version])
  @@index([department, shiftCode, isActive])
}

model ShiftControlTemplateTask {
  id                 Int                  @id @default(autoincrement())
  templateId         Int
  title              String
  category           String
  sortOrder          Int
  required           Boolean              @default(true)
  plannedTimeMinutes Int?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  template           ShiftControlTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tasks              ShiftControlTask[]

  @@index([templateId, sortOrder])
  @@index([category])
}

model ShiftControlRun {
  id             Int                   @id @default(autoincrement())
  workDayEntryId Int                   @unique
  userId         Int
  department     String
  date           String
  templateId     Int?
  status         String                @default("active")
  startedAt      DateTime              @default(now())
  submittedAt    DateTime?
  completedAt    DateTime?
  closingComment String                @default("")
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  workDayEntry   WorkDayEntry          @relation(fields: [workDayEntryId], references: [id], onDelete: Cascade)
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  template       ShiftControlTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  tasks          ShiftControlTask[]

  @@index([userId, date])
  @@index([department, date])
  @@index([status])
}

model ShiftControlTask {
  id                 Int                        @id @default(autoincrement())
  runId              Int
  templateTaskId     Int?
  title              String
  category           String
  sortOrder          Int
  required           Boolean                    @default(true)
  plannedTimeMinutes Int?
  status             String                     @default("pending")
  completedAt        DateTime?
  numericValue       Float?
  integerValue       Int?
  booleanValue       Boolean?
  textValue          String?
  handoverData       Json?
  comment            String                     @default("")
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  run                ShiftControlRun            @relation(fields: [runId], references: [id], onDelete: Cascade)
  templateTask       ShiftControlTemplateTask?  @relation(fields: [templateTaskId], references: [id], onDelete: SetNull)
  manualReviews      ShiftControlManualReview[]
  notifications      WorkdayNotification[]
  controlIssues      WorkdayControlIssue[]

  @@index([runId, sortOrder])
  @@index([status])
  @@index([category])
}

model WorkdayPushSubscription {
  id         Int       @id @default(autoincrement())
  userId     Int
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String    @default("")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  disabledAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, disabledAt])
}

model WorkdayControlIssue {
  id                     Int                          @id @default(autoincrement())
  userId                 Int
  taskId                 Int?
  fingerprint            String                       @unique
  ruleKey                String
  severity               String
  status                 String                       @default("open")
  title                  String
  detail                 String
  sourceData             Json?
  detectedAt             DateTime                     @default(now())
  lastDetectedAt         DateTime                     @default(now())
  nextReminderAt         DateTime?
  employeeActionRequired Boolean                      @default(false)
  originDate             String                       @default("")
  resolvedAt             DateTime?
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  user                   User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  task                   ShiftControlTask?            @relation(fields: [taskId], references: [id], onDelete: SetNull)
  notifications          WorkdayNotification[]
  messages               WorkdayControlIssueMessage[]

  @@index([userId, status])
  @@index([taskId, status])
  @@index([status, nextReminderAt])
  @@index([userId, employeeActionRequired, status])
}

model WorkdayControlIssueMessage {
  id        String              @id @default(cuid())
  issueId   Int
  authorId  Int
  body      String
  createdAt DateTime            @default(now())
  issue     WorkdayControlIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author    User                @relation("WorkdayControlIssueMessageAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([issueId, createdAt])
  @@index([authorId, createdAt])
}

model WorkdayCloseExceptionRequest {
  id              String       @id @default(cuid())
  workDayEntryId  Int
  employeeId      Int
  status          String       @default("pending")
  reasonCode      String
  comment         String
  issueIds        Json
  requestedAt     DateTime     @default(now())
  decidedAt       DateTime?
  decidedById     Int?
  decisionComment String       @default("")
  consumedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  workDayEntry    WorkDayEntry @relation(fields: [workDayEntryId], references: [id], onDelete: Cascade)
  employee        User         @relation("WorkdayCloseExceptionEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  decidedBy       User?        @relation("WorkdayCloseExceptionDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([workDayEntryId, status, requestedAt])
  @@index([employeeId, status, requestedAt])
  @@index([status, requestedAt])
}

model WorkdayNotification {
  id           Int                           @id @default(autoincrement())
  userId       Int
  taskId       Int?
  issueId      Int?
  reviewId     String?
  fingerprint  String                        @unique
  kind         String
  title        String
  body         String
  status       String                        @default("pending")
  scheduledAt  DateTime
  sentAt       DateTime?
  readAt       DateTime?
  attemptCount Int                           @default(0)
  lastError    String                        @default("")
  createdAt    DateTime                      @default(now())
  updatedAt    DateTime                      @updatedAt
  user         User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  task         ShiftControlTask?             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  issue        WorkdayControlIssue?          @relation(fields: [issueId], references: [id], onDelete: Cascade)
  review       TerminalFiscalEmployeeReview? @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([userId, status, scheduledAt])
  @@index([taskId, kind])
  @@index([issueId, kind])
  @@index([reviewId, kind])
}

model ShiftControlManualReview {
  id           Int              @id @default(autoincrement())
  taskId       Int
  checkId      String
  checkLabel   String
  decision     String
  comment      String
  reviewedById Int
  reviewedAt   DateTime         @default(now())
  createdAt    DateTime         @default(now())
  task         ShiftControlTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reviewedBy   User             @relation("ShiftControlManualReviewReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([taskId, checkId, reviewedAt])
  @@index([reviewedById, reviewedAt])
}

model Attestation {
  id           Int               @id @default(autoincrement())
  title        String
  passingScore Int
  status       String            @default("DRAFT")
  type         String            @default("PRACTICE")
  sections     Section[]
  results      Result[]
  progresses   AttemptProgress[]
  resets       AttemptReset[]
}

model Section {
  id            Int         @id @default(autoincrement())
  title         String
  order         Int         @default(0)
  attestationId Int
  attestation   Attestation @relation(fields: [attestationId], references: [id], onDelete: Cascade)
  questions     Question[]
}

model Question {
  id           Int     @id @default(autoincrement())
  text         String
  options      String
  correctIndex Int
  order        Int     @default(0)
  sectionId    Int
  section      Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

model AttemptProgress {
  id            Int         @id @default(autoincrement())
  userId        Int
  attestationId Int
  answers       String      @default("{}")
  questionOrder String
  currentIndex  Int         @default(0)
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  attestation   Attestation @relation(fields: [attestationId], references: [id], onDelete: Cascade)

  @@unique([userId, attestationId])
}

model Result {
  id             Int         @id @default(autoincrement())
  userId         Int
  attestationId  Int
  date           DateTime    @default(now())
  percent        Int
  status         String
  correctCount   Int
  totalQuestions Int
  mistakes       Int
  details        String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  attestation    Attestation @relation(fields: [attestationId], references: [id], onDelete: Cascade)
}

model AttemptReset {
  id            Int         @id @default(autoincrement())
  userId        Int
  attestationId Int
  resetById     Int
  date          DateTime    @default(now())
  user          User        @relation("ResetTarget", fields: [userId], references: [id], onDelete: Cascade)
  resetBy       User        @relation("ResetBy", fields: [resetById], references: [id], onDelete: Cascade)
  attestation   Attestation @relation(fields: [attestationId], references: [id], onDelete: Cascade)
}

model PayrollPeriod {
  id        Int          @id @default(autoincrement())
  year      Int
  month     Int
  periodKey String       @unique
  status    String       @default("OPEN")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  closedAt  DateTime?
  runs      PayrollRun[]

  @@unique([year, month])
}

model PayrollRun {
  id              Int                     @id @default(autoincrement())
  periodId        Int
  runNumber       Int
  status          String                  @default("DRAFT")
  rulesVersion    String                  @default("client-snapshot-v1")
  employeeCount   Int                     @default(0)
  reviewCount     Int                     @default(0)
  grossPay        Float                   @default(0)
  netPay          Float                   @default(0)
  advance         Float                   @default(0)
  deductions      Float                   @default(0)
  dayPay          Float                   @default(0)
  salesBonus      Float                   @default(0)
  disciplineBonus Float                   @default(0)
  sourceSummary   Json?
  createdByUserId Int?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  checkedAt       DateTime?
  closedAt        DateTime?
  period          PayrollPeriod           @relation(fields: [periodId], references: [id], onDelete: Cascade)
  createdBy       User?                   @relation("PayrollRunCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  employeeResults PayrollEmployeeResult[]
  sourceFiles     PayrollSourceFile[]
  manualInputs    PayrollManualInput[]
  adjustments     PayrollAdjustment[]
  analyticsRows   PayrollAnalyticsRow[]

  @@unique([periodId, runNumber])
}

model PayrollEmployeeResult {
  id                       Int                        @id @default(autoincrement())
  runId                    Int
  employeeName             String
  userId                   Int?
  department               String
  payrollDepartment        String
  position                 String
  salaryType               String
  salaryRule               String
  workedDays               Float?
  lateCount                Float?
  daysSource               String
  dayRate                  Float                      @default(0)
  dayPay                   Float                      @default(0)
  revenue                  Float                      @default(0)
  grossProfit              Float                      @default(0)
  creditBonus              Float                      @default(0)
  filmBonus                Float                      @default(0)
  plotterBonus             Float                      @default(0)
  techBonus                Float                      @default(0)
  accessoryBonus           Float                      @default(0)
  wholesaleBonus           Float                      @default(0)
  salesBonus               Float                      @default(0)
  totalBonus               Float                      @default(0)
  disciplineBonus          Float                      @default(0)
  fixedSalary              Float                      @default(0)
  fixedBonus               Float                      @default(0)
  fixedDeduction           Float                      @default(0)
  purchaseBase             Float?
  purchasePercent          Float                      @default(0)
  purchasePercentAmount    Float                      @default(0)
  purchaseTargetAdjustment Float                      @default(0)
  purchaseTargetSalary     Float                      @default(0)
  agentCreditCommission    Float                      @default(0)
  advance                  Float                      @default(0)
  grossPay                 Float                      @default(0)
  netPay                   Float                      @default(0)
  status                   String
  reasons                  Json?
  comment                  String                     @default("")
  order                    Int                        @default(0)
  run                      PayrollRun                 @relation(fields: [runId], references: [id], onDelete: Cascade)
  calculationDetails       PayrollCalculationDetail[]
  adjustments              PayrollAdjustment[]

  @@index([runId])
  @@index([employeeName])
}

model PayrollSourceFile {
  id             Int                   @id @default(autoincrement())
  runId          Int
  type           String
  originalName   String
  extension      String
  mimeType       String?
  sizeBytes      Int?
  sha256         String?
  uploadedAt     DateTime              @default(now())
  selectedSheet  String?
  rowCount       Int?
  parsedRowCount Int?
  status         String                @default("UPLOADED")
  warnings       Json?
  metadata       Json?
  run            PayrollRun            @relation(fields: [runId], references: [id], onDelete: Cascade)
  analyticsRows  PayrollAnalyticsRow[]

  @@index([runId])
  @@index([sha256])
}

model PayrollAnalyticsRow {
  id                  Int                @id @default(autoincrement())
  payrollRunId        Int
  sourceFileId        Int?
  periodKey           String
  year                Int
  month               Int
  employeeName        String
  employeeId          Int?
  department          String?
  location            String?
  client              String?
  category            String?
  nomenclatureType    String?
  itemName            String
  article             String?
  quantity            Float?
  revenue             Float              @default(0)
  cost                Float              @default(0)
  grossProfit         Float              @default(0)
  marginPercent       Float?
  markupPercent       Float?
  calculationType     String
  componentType       String?
  commissionAmount    Float              @default(0)
  isCredit            Boolean            @default(false)
  isReturn            Boolean            @default(false)
  isNegative          Boolean            @default(false)
  isManualRuleApplied Boolean            @default(false)
  manualRuleLabel     String?
  problemFlags        Json?
  checkReason         String?
  createdAt           DateTime           @default(now())
  payrollRun          PayrollRun         @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  sourceFile          PayrollSourceFile? @relation(fields: [sourceFileId], references: [id], onDelete: SetNull)

  @@index([payrollRunId])
  @@index([periodKey])
  @@index([employeeName])
  @@index([calculationType])
  @@index([isCredit])
  @@index([isNegative])
}

model SalesAnalyticsReport {
  id               Int                 @id @default(autoincrement())
  period           String
  sourceReportType String              @default("extended_vgp")
  fileName         String
  uploadedAt       DateTime            @default(now())
  rowsCount        Int                 @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  rows             SalesAnalyticsRow[]

  @@index([period])
  @@index([sourceReportType])
  @@index([uploadedAt])
}

model SalesAnalyticsRow {
  id               Int                  @id @default(autoincrement())
  reportId         Int
  sourceReportType String               @default("extended_vgp")
  employeeName     String
  department       String?
  location         String?
  client           String?
  category         String?
  nomenclatureType String?
  itemName         String
  article          String?
  quantity         Float?
  revenue          Float                @default(0)
  cost             Float                @default(0)
  grossProfit      Float                @default(0)
  marginPercent    Float?
  markupPercent    Float?
  documentName     String?
  documentType     String               @default("UNKNOWN")
  documentDate     DateTime?
  unitRevenue      Float?
  unitCost         Float?
  unitGrossProfit  Float?
  isCredit         Boolean              @default(false)
  isReturn         Boolean              @default(false)
  isRealReturn     Boolean              @default(false)
  isNegative       Boolean              @default(false)
  problemFlags     Json?
  checkReason      String?
  createdAt        DateTime             @default(now())
  report           SalesAnalyticsReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([sourceReportType])
  @@index([employeeName])
  @@index([documentType])
  @@index([isCredit])
  @@index([isRealReturn])
  @@index([isNegative])
}

model PayrollManualInput {
  id                    Int        @id @default(autoincrement())
  runId                 Int
  employeeName          String
  inputType             String
  workedDays            String?
  lateCount             String?
  advance               String?
  agentCreditCommission String?
  fixedBonus            String?
  fixedDeduction        String?
  purchaseAdvance       String?
  purchaseDeduction     String?
  comment               String     @default("")
  source                String?
  updatedAt             DateTime   @default(now())
  run                   PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([employeeName])
}

model PayrollCalculationDetail {
  id               Int                   @id @default(autoincrement())
  employeeResultId Int
  component        String
  base             Float?
  formula          String
  amount           Float                 @default(0)
  comment          String                @default("")
  order            Int                   @default(0)
  employeeResult   PayrollEmployeeResult @relation(fields: [employeeResultId], references: [id], onDelete: Cascade)

  @@index([employeeResultId])
}

model PayrollAdjustment {
  id               Int                    @id @default(autoincrement())
  runId            Int
  employeeResultId Int?
  type             String
  amount           Float                  @default(0)
  reason           String
  comment          String                 @default("")
  createdByUserId  Int?
  createdAt        DateTime               @default(now())
  run              PayrollRun             @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeResult   PayrollEmployeeResult? @relation(fields: [employeeResultId], references: [id], onDelete: Cascade)
  createdBy        User?                  @relation("PayrollAdjustmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([employeeResultId])
}

model PayrollClassificationRule {
  id                    Int      @id @default(autoincrement())
  title                 String?
  isActive              Boolean  @default(true)
  priority              Int      @default(100)
  matchType             String
  itemText              String?
  categoryText          String?
  article               String?
  department            String?  @default("all")
  saleContext           String?  @default("all")
  targetCalculationType String
  reason                String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([isActive, priority])
  @@index([matchType])
  @@index([targetCalculationType])
}
